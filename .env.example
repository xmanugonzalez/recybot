# Puente web de la Pi 3. Solo lo utiliza el servidor de Vite.
RECYBOT_BRIDGE_URL=http://10.199.232.50:8080

# Cámara y puente. En Windows usa opencv; en Pi 3 usa picamera2.
RECYBOT_CAMERA_BACKEND=opencv
RECYBOT_CAMERA_INDEX=0
RECYBOT_CAMERA_FLIP_HORIZONTAL=true
RECYBOT_CAMERA_URL=http://127.0.0.1:8765
RECYBOT_AI_URL=http://127.0.0.1:8766
RECYBOT_API_TOKEN_PATH=ai/config/api-token

# El navegador usa su propia cámara por defecto. Usa "server" únicamente cuando
# esta interfaz esté desplegada junto al adaptador Picamera2 de Recybot.
VITE_CAMERA_SOURCE=device

# Servicio Python de IA (configurar en la PC o Pi que lo ejecute).
RECYBOT_MODEL_PATH=modelos/yolov8n.pt
RECYBOT_MODEL_MODE=prueba
RECYBOT_INFERENCE_BACKEND=local
RECYBOT_CONFIDENCE=0.4
RECYBOT_IMAGE_SIZE=320
RECYBOT_COLLECT_SAMPLES=true
RECYBOT_LEARNING_DIR=datos_aprendizaje

# Roboflow (los identificadores no son secretos; la API key vive en ai/config/).
ROBOFLOW_MODEL_ID=ee4016/3
ROBOFLOW_WORKSPACE=ai-vision-lab-be6pb
ROBOFLOW_PROJECT=recybot-ai-7jhnn
ROBOFLOW_API_KEY_PATH=config/roboflow-api-key
